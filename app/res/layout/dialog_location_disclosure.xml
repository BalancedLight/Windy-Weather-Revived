<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/location_disclosure_dialog_content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/settings_dialog_horizontal_padding"
    android:paddingTop="@dimen/settings_dialog_vertical_padding"
    android:paddingEnd="@dimen/settings_dialog_horizontal_padding"
    android:paddingBottom="16dp">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/text_location_disclosure_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_location_disclosure_title"
        android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/location_disclosure_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fadeScrollbars="false"
        android:fillViewport="false"
        android:overScrollMode="ifContentScrolls">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/text_location_disclosure_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="3dp"
            android:text="@string/settings_location_disclosure_message"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_disclosure_privacy_policy"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minHeight="@dimen/settings_control_min_height"
        android:text="@string/settings_location_disclosure_privacy_link" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_disclosure_not_now"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/settings_control_min_height"
            android:text="@string/settings_location_disclosure_cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_disclosure_continue"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/settings_control_min_height"
            android:text="@string/settings_location_disclosure_continue" />
    </LinearLayout>
</LinearLayout>
