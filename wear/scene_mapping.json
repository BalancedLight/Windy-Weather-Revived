  "temperature_overlay": {
    "_comment": "D8_ICE_COLD has no WFF condition enum, so it is recreated from temperature instead. Thresholds are compared per unit because [WEATHER.TEMPERATURE] is reported in the user's preferred unit and [WEATHER.TEMPERATURE_UNIT] is 1 for Celsius and 2 for Fahrenheit.",
    "source_scene": "D8_ICE_COLD",
    "freezing": {
      "celsius": 0,
      "fahrenheit": 32
    },
    "deep_cold": {
      "celsius": -8,
      "fahrenheit": 18
    },
    "effect": "overlay_frost fades in at freezing and reaches full strength at the deep-cold threshold",
    "expression": "([WEATHER.TEMPERATURE_UNIT] == 2) ? ([WEATHER.TEMPERATURE] < 32) : ([WEATHER.TEMPERATURE] < 0)"
  },
  "availability": {
    "never_available": "WEATHER.IS_AVAILABLE false: render the neutral D1_CLEAR scene with day/night taken from the clock hour, the full clock, and a small unavailable dot.",
    "stale_but_available": "WEATHER.IS_AVAILABLE true and WEATHER.IS_ERROR true: keep rendering the last known scene and show the same small indicator dot.",
    "healthy": "WEATHER.IS_AVAILABLE true and WEATHER.IS_ERROR false: render normally with no indicator."
  },
  "day_night": {
    "source": "[WEATHER.IS_DAY]",
    "fallback": "[HOUR_0_23] >= 7 && [HOUR_0_23] < 19, used only when weather has never been available",
