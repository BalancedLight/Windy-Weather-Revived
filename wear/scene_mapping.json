  "animation": {
    "rotor": "angle = [SECOND_MILLISECOND] * 24 * speed, which is an exact multiple of 360 per minute so the rotation never jumps at the minute boundary",
    "cloud_drift": "x = -width + fract([SECONDS_IN_DAY] / drift_seconds) * (450 + width)",
    "precipitation": "y = (fract([SECOND_MILLISECOND] / period) * 450) - 450 on a 450x900 vertically seamless strip; every period divides 60 exactly",
    "fog_drift": "x = -450 + fract([SECONDS_IN_DAY] / 96) * 450 on a 900x450 horizontally seamless strip",
    "twinkle": "alpha = triangle wave built from fract() and abs(); no trigonometry so the result does not depend on whether sin() takes degrees or radians",
    "storm": "flash and bolt alpha are sawtooth pulses on a four-second cycle, offset per bolt",
    "parallax": "Gyro x/y on the scene group, clamped to plus or minus 6 logical pixels for the sky and plus or minus 10 for the ground"
  },
