    {
      "wff_value": 15,
      "wff_name": "WINDY",
      "scene": "D2_CLOUDY",
      "intensity": "windy",
      "note": "Cloudy sky treatment with cloud drift and rotor speed raised; the mobile renderer already scales rotor speed with wind, so this is the same idea driven from the condition enum."
    }
